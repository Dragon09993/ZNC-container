# Environment variables for ZNC Docker setup
# Copy this file to .env and modify as needed
# IMPORTANT: Never commit .env to git - it contains sensitive information!

# Base Image Selection (ubuntu:22.04 or alpine:3.19)
BASE_IMAGE=ubuntu:22.04

# ZNC Admin User Configuration
ZNC_USER=admin
ZNC_PASSWORD=CHANGE_THIS_PASSWORD

# IRC Configuration
ZNC_IRC_NICK=your_nick
ZNC_IRC_SERVER=localhost
ZNC_IRC_PORT=6667
ZNC_IRC_SSL=false

# User/Group IDs (match your host user)
PUID=1000
PGID=1000

# Domain for reverse proxy (optional)
DOMAIN=localhost